  "narrative": {
    "northStar": "Calm Marketplace",
    "overview": "A consumer-friendly Georgian booking marketplace: soft blush ground, white rounded cards, one warm coral-rose accent, real business photos in front. One type family at normal width, hierarchy by weight, no capitals. The business panel is the same product: same tokens and accent, a dark plum rail matching the public business band, denser ramp and 40px controls. It replaces the earlier Appointment Card world (indigo desk, violet stamp, perforated tickets, mono numerals).",
    "keyCharacteristics": [
      "Blush neutral ground with white cards, 1px border plus sm shadow.",
      "One accent (coral rose); accent-ink for text, accent for fills.",
      "Real cover photos; tinted initial tiles when there is no photo; empty sections are not rendered.",
      "Noto Sans Georgian at normal width; tabular-nums for numbers; no uppercase.",
      "Radii 8 controls, 12 panel cards, 16 public cards, 20 hero, pill marks.",
      "Dark plum band for the business section and the panel rail."
    ],
    "rules": [
      {
        "name": "One Accent Rule",
        "body": "Coral rose is the only brand hue; verticals and semantics never compete with it on one control.",
        "section": "colors"
      },
      {
        "name": "Ink Rule",
        "body": "Never set plain accent as text over the ground; use accent-ink (5.65:1).",
        "section": "colors"
      },
      {
        "name": "Pair Rule",
        "body": "Every tint pairs with its ink; status is icon plus word plus colour.",
        "section": "colors"
      },
      {
        "name": "No Capitals Rule",
        "body": "text-transform: uppercase is banned; letter-spacing is 0.",
        "section": "typography"
      }
    ],
    "dos": [
      "Use real business imagery and design a fallback for each photo slot.",
      "Keep public body copy at 16px or larger.",
      "Use accent-ink for accent-coloured text and links.",
      "Hide sections that have no content."
    ],
    "donts": [
      "No uppercase, Martian Mono, serif display or condensed widths.",
      "No gradients, glows, glass blur, perforations, notches or rotated stamps.",
      "No filled destructive buttons; no colour-only state.",
      "No stock photos, fake salons or invented reviews."
    ]
  }
}
